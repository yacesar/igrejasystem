# ---- Supabase (projeto de desenvolvimento) ----
# Painel do Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon / publishable). Pode ir ao navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Chave de serviço (service_role). NUNCA vai ao navegador. Usada só em seeds/jobs.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ---- Banco (Postgres do Supabase) ----
# Painel → Project Settings → Database → Connection string (URI, modo "Session" para migrações)
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Asaas (sandbox) — usado a partir da Fase 1 ----
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
